[Unit]
Description=TradFR - verification periodique des mises a jour d'ARK

[Timer]
# une verification par heure suffit : le script ne fait rien tant que le pak
# du jeu n'a pas change, et ne signale chaque mise a jour qu'une seule fois
OnBootSec=10min
OnUnitActiveSec=1h
Persistent=true

[Install]
WantedBy=timers.target
